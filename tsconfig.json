{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "dom",
      "ESNext"
    ],
    "types": [
      "node"
    ]
  },
  "exclude": ["node_modules", "./**/*.test.ts"],
  "include": [
    "./lib/**/*.ts"
  ]
}
